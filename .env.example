# Copy this file to .env and fill in the key(s) for the provider(s) you use.
# Miss Data only needs ONE model-provider key, matching whichever provider
# you select with --provider / /provider (Groq by default). Ollama needs
# none of these (it's a local server).

GROQ_API_KEY=
ANTHROPIC_API_KEY=

# OpenAI-compatible providers — fill in only the one(s) you use.
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
TOGETHER_API_KEY=
MISTRAL_API_KEY=
FIREWORKS_API_KEY=
XAI_API_KEY=
MOONSHOT_API_KEY=
PERPLEXITY_API_KEY=

# For --provider custom (any other OpenAI-compatible endpoint): the env var
# name is configurable via /api-key-env; CUSTOM_API_KEY is the default.
CUSTOM_API_KEY=

# Optional: if set, web_search uses the Brave Search API (more reliable).
# Free key at https://brave.com/search/api/. If left empty, web_search
# automatically falls back to scraping DuckDuckGo (no key needed).
BRAVE_API_KEY=
